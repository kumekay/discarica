#!/bin/sh
# Pre-commit: lint + tests. Enable with: git config core.hooksPath .githooks
set -e

if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "golangci-lint not found; install with:" >&2
    echo "  go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest" >&2
    exit 1
fi

echo "pre-commit: golangci-lint"
golangci-lint run

echo "pre-commit: go test"
go test ./...
